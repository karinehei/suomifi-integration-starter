{
  "request": {
    "method": "POST",
    "url": "/oauth/token",
    "headers": {
      "Content-Type": {
        "equalTo": "application/x-www-form-urlencoded"
      }
    },
    "bodyPatterns": [
      {
        "matches": ".*grant_type=authorization_code.*"
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": "{\n  \"access_token\": \"demo-access-token-{{randomValue length=16 type='ALPHANUMERIC'}}\",\n  \"id_token\": \"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJkZW1vLXVzZXIiLCJpc3MiOiJzdW9taWZpLXN0dWIiLCJhdWQiOiJkZW1vLWNsaWVudC1pZCIsImV4cCI6OTk5OTk5OTk5OSwiaWF0IjoxNzA1MzI0MDAwfQ.signature-placeholder\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 3600,\n  \"scope\": \"openid profile\"\n}"
  }
}
